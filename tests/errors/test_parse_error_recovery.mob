// Malformed programs must fail with a clean parse error (exit 1): no crash,
// no hang, and no running of a program that failed to parse. Each snippet
// is written to a temp file and run in a separate interpreter.
import "os"

var mobius_bin = os.join(os.getcwd(), "bin", "mobius")
var workspace = os.join(os.tmpdir(), "mobius_parse_recovery_" + str(os.getpid()))
os.mkdirp(workspace)
var failures = 0
var counter = 0

func expect_parse_error(name, source) {
    counter = counter + 1
    var path = os.join(workspace, "case" + str(counter) + ".mob")
    writefile(path, source)
    var code = os.system("timeout 10 \"" + mobius_bin + "\" \"" + path + "\" > /dev/null 2>&1")
    if (code != 1) {
        failures = failures + 1
        print("FAIL: " + name + ": exit code " + str(code) + " (expected 1)")
    }
}

// Assignment or compound assignment with a missing or broken side.
expect_parse_error("assignment without target", "= 5\n")
expect_parse_error("compound assignment without target", "+= 1\n")
expect_parse_error("nested assignment without target", "x = (= 3)\n")
expect_parse_error("assignment without value", "var y = 1\ny = \n")
expect_parse_error("compound assignment without value", "var a = [1]\na[0] += \n")

// A postfix operator must not wrap an operand that failed to parse.
expect_parse_error("spawn of prefix increment", "spawn ++x\n")

// Error recovery must make progress when a statement fails on its first
// token right after a ';' (this used to loop forever).
expect_parse_error("stray ) after ;", "var x = 1; )\n")
expect_parse_error("stray } after ;", "var x = 1; }\n")
expect_parse_error("stray ) after ; in block", "if (true) { print(1); ) }\n")
expect_parse_error("stray ] after ; in function", "func f() {\n  var a = 1; ]\n}\n")

// Errors inside switch default bodies and destructuring patterns must not
// loop (these hung while allocating without bound).
expect_parse_error("bad statement in default body", "switch (1) {\n default: )\n}\n")
expect_parse_error("bad return in default body", "func f(v) {\n switch (v) {\n  default:\n   return , \"none\"\n }\n}\n")
expect_parse_error("literal in array pattern", "switch ([1]) {\n case [1]: print(1)\n}\n")
expect_parse_error("literal in table pattern", "switch ({}) {\n case {1}: print(1)\n}\n")
expect_parse_error("truncated array pattern", "switch ([1]) {\n case [a,")
expect_parse_error("truncated table pattern", "switch ({}) {\n case {a: ")

// A parse error inside `${...}` is an error in the file: the program must
// not run (it used to run, or crash in the compiler).
expect_parse_error("bad token in interpolation", "print(`a${)}b`)\n")
expect_parse_error("incomplete expression in interpolation", "var x = 1\nprint(`a${x +}b`)\n")
expect_parse_error("extra tokens in interpolation", "var x = 1\nprint(`${x 2}`)\n")
expect_parse_error("empty interpolation", "print(`${}`)\n")

// Very deep nesting is a parse error, not a C stack overflow.
expect_parse_error("100000 nested parentheses", "print(" + repeat("(", 100000) + "1" + repeat(")", 100000) + ")\n")
expect_parse_error("100000 nested arrays", "var a = " + repeat("[", 100000) + "1" + repeat("]", 100000) + "\n")
expect_parse_error("50000 nested blocks", repeat("if (true) {\n", 50000) + "print(1)\n" + repeat("}\n", 50000))
expect_parse_error("5000 nested function literals", "var f = " + repeat("func() { return ", 5000) + "1" + repeat(" }", 5000) + "\n")

// Ordinary deep code still parses.
var deep_path = os.join(workspace, "deep_ok.mob")
writefile(deep_path, "print(" + repeat("(", 60) + "1" + repeat(")", 60) + ")\n" +
    repeat("if (true) {\n", 40) + "print(2)\n" + repeat("}\n", 40))
if (os.system("timeout 10 \"" + mobius_bin + "\" \"" + deep_path + "\" > /dev/null 2>&1") != 0) {
    failures = failures + 1
    print("FAIL: 60 nested parentheses and 40 nested blocks should run")
}

os.system("rm -rf \"" + workspace + "\"")
if (failures > 0) {
    exit(1)
}
print("parse error recovery: PASS")
