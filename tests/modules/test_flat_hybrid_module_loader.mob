import "os"

var pass_count = 0
var fail_count = 0

func assert_test(name, cond) {
    if (cond) {
        pass_count = pass_count + 1
        print("PASS: " + name)
    } else {
        fail_count = fail_count + 1
        print("FAIL: " + name)
    }
}

var repo_root = os.getcwd()

// This platform's names: the native folder the build stages libraries in
// (arm64, not aarch64, on Apple Silicon) and shared library file names.
var native_folder = replace(os.platform, "-aarch64", "-arm64")
var lib_prefix = "lib"
var lib_ext = ".so"
if (startswith(os.platform, "windows")) {
    lib_prefix = ""
    lib_ext = ".dll"
} else if (startswith(os.platform, "macos")) {
    lib_ext = ".dylib"
}
var mobius_bin = os.join(repo_root, "bin", "mobius")
var url_so_src = os.join(repo_root, "bin", "modules", "url", "native", native_folder, "url" + lib_ext)
var core_so_src = os.join(repo_root, "bin", lib_prefix + "mobius-core" + lib_ext)

var workspace = os.join(os.tmpdir(), "mobius_flat_hybrid_" + str(os.getpid()))
var wrapper_path = os.join(workspace, "url.mob")
var native_path = os.join(workspace, "url" + lib_ext)
var core_path = os.join(workspace, lib_prefix + "mobius-core" + lib_ext)
var run_script = os.join(workspace, "run.mob")

assert_test("url native exists", os.is_file(url_so_src))
assert_test("mobius core exists", os.is_file(core_so_src))
assert_test("create workspace", os.mkdirp(workspace))
assert_test("copy url native", os.cp(url_so_src, native_path))
assert_test("copy mobius core", os.cp(core_so_src, core_path))
assert_test("write url wrapper", writefile(wrapper_path,
    "func decode_space() {\n" +
    "    return decode(\"a%20b\")\n" +
    "}\n" +
    "\n" +
    "func decode_slash() {\n" +
    "    return decode(\"%2F\")\n" +
    "}\n" +
    "\n" +
    "var wrapper_loaded = true\n"))
assert_test("write runner", writefile(run_script,
    "import \"url\" as url\n" +
    "if (typeof(url.parse) != \"function\") { exit(11) }\n" +
    "if (url.wrapper_loaded != true) { exit(12) }\n" +
    "if (url.decode_space() != \"a b\") { exit(13) }\n" +
    "if (url.decode_slash() != \"/\") { exit(14) }\n" +
    "print(\"flat hybrid import ok\")\n"))

var old_cwd = os.getcwd()
assert_test("chdir into workspace", os.chdir(workspace))
var import_rc = os.system(mobius_bin + " " + run_script)
if (import_rc != 0) {
    // 11-14: which of the runner's checks failed.
    print("  the runner exited with " + str(import_rc))
}
assert_test("import flat hybrid module", import_rc == 0)
assert_test("chdir back to repo root", os.chdir(old_cwd))

os.remove(run_script)
os.remove(wrapper_path)
os.remove(native_path)
os.remove(core_path)
os.rmdir(workspace)

print("")
print("Flat Hybrid Module Loader Tests: " + str(pass_count) + " passed, " + str(fail_count) + " failed")
if (fail_count == 0) {
    print("ALL TESTS PASSED")
} else {
    exit(1)
}
