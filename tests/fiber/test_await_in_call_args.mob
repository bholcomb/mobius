// Regression: `await` used as a call argument must not shift the arguments
// that follow it (the spawn's temporary register used to stay allocated).
func one() { return 1 }
func join3(a, b, c) { return str(a) + "," + str(b) + "," + str(c) }

func check(name, got, want) {
    if (got != want) {
        print("FAIL: " + name + ": expected " + want + ", got " + got)
        exit(1)
    }
}

check("await in middle", join3("x", await spawn one(), 2), "x,1,2")
check("await first", join3(await spawn one(), "y", 2), "1,y,2")
check("await last", join3("x", 2, await spawn one()), "x,2,1")
check("two awaits", join3(await spawn one(), await spawn one(), 3), "1,1,3")
var f = spawn one()
check("await a local future", join3("x", await f, 2), "x,1,2")
check("future local untouched", typeof(f), "future")
check("nested call", join3(join3(await spawn one(), 2, 3), "b", "c"), "1,2,3,b,c")
print("await in call args: PASS")
