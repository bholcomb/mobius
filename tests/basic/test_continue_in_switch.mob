// `continue` inside a switch continues the enclosing loop. The switch's
// pseudo-loop (so `break` can leave the switch) was taken as the target,
// and the jump went back to the switch's own pattern tests: an infinite
// loop.
func show(arr) {
    var text = ""
    for (var i = 0; i < arr:size(); i++) {
        if (i > 0) { text = text + "," }
        text = text + str(arr[i])
    }
    return text
}

func check(name, got, want) {
    if (show(got) != want) {
        print("FAIL: " + name + ": expected " + want + ", got " + show(got))
        exit(1)
    }
}

var out = []
var i = 0
while (i < 4) {
    i++
    switch (i) { case 2: continue }
    out:push(i)
}
check("while", out, "1,3,4")

var out2 = []
for (var j = 0; j < 4; j++) {
    switch (j) { case 1, 2: continue }
    out2:push(j)
}
check("for", out2, "0,3")

var out3 = []
for (var x in [1, 2, 3, 4]) {
    switch (x) { case 3: continue }
    out3:push(x)
}
check("for-in", out3, "1,2,4")

// Nested switches, and `break` still leaving only the switch.
var out4 = []
for (var k = 0; k < 4; k++) {
    switch (k % 2) {
        case 0:
            switch (k) { case 2: continue }
            break
    }
    out4:push(k)
}
check("nested switch", out4, "0,1,3")
print("continue in switch: PASS")
